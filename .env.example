DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store?schema=public
# Direct (non-pooled) endpoint used by the Prisma CLI for migrations.
# With a pooled provider (Neon/Supabase PgBouncer) this MUST be the direct host —
# a transaction-mode pooler cannot hold the session advisory lock migrate deploy needs.
# Locally, set it to the same value as DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/store?schema=public
BETTER_AUTH_SECRET=dummy-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set true only on a preview deployment that does not have merchant integrations yet.
# Demo mode still requires a real database, auth secret, and HTTPS URLs in production.
DEMO_MODE=false
# Used to authenticate scheduled reconciliation requests.
CRON_SECRET=dummy-cron-secret-change-me
ADMIN_EMAIL=owner@example.com
