DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store?schema=public
# Direct (non-pooled) endpoint used by the Prisma CLI for migrations.
# With a pooled provider (Neon/Supabase PgBouncer) this MUST be the direct host —
# a transaction-mode pooler cannot hold the session advisory lock migrate deploy needs.
# Locally, set it to the same value as DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/store?schema=public
BETTER_AUTH_SECRET=dummy-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used to authenticate scheduled reconciliation requests.
CRON_SECRET=dummy-cron-secret-change-me
ADMIN_EMAIL=owner@example.com
# RESEND_API_KEY=re_dummy_123
# RESEND_FROM="Store <orders@example.com>"
# STRIPE_SECRET_KEY=sk_test_dummy
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy
# STRIPE_WEBHOOK_SECRET=whsec_dummy
# MOYASAR_SECRET_KEY=sk_test_dummy
# NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_dummy
# PAYPAL_CLIENT_ID=dummy-client-id
# PAYPAL_CLIENT_SECRET=dummy-client-secret
# PAYPAL_WEBHOOK_ID=dummy-webhook-id
# PAYPAL_MODE=sandbox
# Paddle Billing (digital goods only; physical goods are prohibited).
NEXT_PUBLIC_PADDLE_ENABLED=false
PADDLE_API_KEY=dummy-paddle-api-key
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=dummy-paddle-client-token
PADDLE_WEBHOOK_SECRET=dummy-paddle-webhook-secret
PADDLE_PRODUCT_ID=dummy-paddle-product-id
PADDLE_ENV=sandbox
# Lemon Squeezy (digital goods only) uses one variant as the custom-price template.
NEXT_PUBLIC_LEMONSQUEEZY_ENABLED=false
LEMONSQUEEZY_API_KEY=dummy-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=dummy-lemonsqueezy-webhook-secret
LEMONSQUEEZY_STORE_ID=000000
LEMONSQUEEZY_VARIANT_ID=000000
LEMONSQUEEZY_TEST_MODE=true
